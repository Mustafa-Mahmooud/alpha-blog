<h1>Create New Article</h1>
<%= form_with model: @article, local: true do |form| %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :descreption %>
    <%= form.text_area :descreption %>
  </div>

  <div class="actions">
    <%= form.submit "Create Article" %>
  </div>
<% end %>
<%= link_to "Back to Articles", articles_path %>
